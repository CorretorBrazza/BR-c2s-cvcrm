function drawChartf() {
    var vp, i, n, amt, tb_, dados, dadost, total, vp_, p, j, linha, linhat, pmt, prefixo;
    switch (jQuery('input[name="tipof"]:checked').val()) {
        case "sac":
            try {
                vp = jQuery("#vp_f").val().replaceAll(".", "").replace(",", ".");
                vp = parseFloat(vp);
                i = jQuery("#tj_f").val().replaceAll(".", "").replace(",", ".");
                n = tempotrans(jQuery("#t_f").val().replaceAll(".", "").replace(",", "."), jQuery("#tj_tf").val(), jQuery("#t_tf").val());
                amt = saca(vp, n);
                vf = sacp(vp, i, n, 1);
                tb_ = '<table class="cv-table cv-table--card table"><tr><td>Valor financiado: </td><td>R$ ' + number_format(vp, 2, ',', '.') + "</td></tr>";
                tb_ += "<tr><td>Valor da 1ª prestação: </td><td>R$ " + number_format(vf, 2, ',', '.') + "</td></tr>";
                tb_ += "<tr><td>Taxa de juros: </td><td>" + number_format(i, 2, ',', '.') + " " + jQuery("#tj_tf :selected").text() + "</td></tr>";
                tb_ += "<tr><td>Tempo de financiamento: </td><td>" + jQuery("#t_f").val() + " " + jQuery("#t_tf :selected").text() + "</td></tr></table>";
                dados = [];
                dadost = [];
                total = 0;
                dados.push(["Período", "Total", "Saldo Devedor"]);
                dadost.push(["Período", "Saldo Devedor", "Amortização", "Juros", "Prestação"]);
                vp_ = vp;
                for (var c = 1; c <= parseInt(n); c++) {
                    vp_ -= amt;
                    p = sacp(vp, i, n, c);
                    j = sacj(vp, i, n, c);
                    total += p;
                    linha = [c, total, vp_];
                    linhat = [c, vp_, amt, j, p];
                    dados.push(linha);
                    dadost.push(linhat);
                }
                var options = {
                    legend: {
                        position: "bottom"
                    },
                    focusTarget: "category"
                };
            } catch (e) {}
            break;
        case "price":
            try {
                vp_f = jQuery("#vp_f").val();
                vp = vp_f.replaceAll(".", "").replace(",", ".");
                vp = parseFloat(vp);
                i = jQuery("#tj_f").val().replaceAll(".", "").replace(",", ".");
                n = tempotrans(jQuery("#t_f").val().replaceAll(".", "").replace(",", "."), jQuery("#tj_tf").val(), jQuery("#t_tf").val());
                p = pricep(vp, i, n);
                amt = 0;
                tb_ = '<table class="cv-table cv-table--card table"><tr><td>Valor financiado: </td><td>R$ ' + number_format(vp_f, 2, ',', '.') + "</td></tr>";
                tb_ += "<tr><td>Valor da 1ª prestação: </td><td>R$ " + number_format(p, 2, ',', '.') + "</td></tr>";
                tb_ += "<tr><td>Taxa de juros: </td><td>" + number_format(i, 2, ',', '.') + " " + jQuery("#tj_tf :selected").text() + "</td></tr>";
                tb_ += "<tr><td>Tempo de financiamento: </td><td>" + jQuery("#t_f").val() + " " + jQuery("#t_tf :selected").text() + "</td></tr></table>";
                dados = [];
                dadost = [];
                total = 0;
                dados.push(["Período", "Total", "Saldo Devedor"]);
                dadost.push(["Período", "Saldo Devedor", "Amortização", "Juros", "Prestação"]);
                vp_ = vp;
                for (var c = 1; c <= parseInt(n); c++) {
                    amt = pricea(vp, p, i, c);
                    vp_ -= amt;
                    j = pricej(p, i, n, c);
                    total += p;
                    linha = [c, total, vp_];
                    linhat = [c, vp_, amt, j, p];
                    dados.push(linha);
                    dadost.push(linhat);
                }
                var options = {
                    curveType: "function",
                    legend: {
                        position: "bottom"
                    },
                    focusTarget: "category"
                };
            } catch (e) {}
            break;
    }
    prefixo = jQuery("#tj_tf option:selected").text().replace("% ao", "");
    var data = google.visualization.arrayToDataTable(dados);
    var formatter0 = new google.visualization.NumberFormat({
        prefix: prefixo + ": ",
        fractionDigits: 2
    });
    var formatter = new google.visualization.NumberFormat({
        prefix: "R$ ",
        fractionDigits: 2
    });
    formatter.format(data, 1);
    formatter0.format(data, 0);
    try {
        formatter.format(data, 2);
    } catch (e) {}
    var chart = new google.visualization.LineChart(document.getElementById("graficof"));
    chart.draw(data, options);
    montatabf(dadost);
    jQuery("#tabresuf").html(tb_);
}

function drawChart_vp() {
    var vf, i, n, vp, amt, dados, dadost, total, vp_, ttamt, p, j, linha, linhat, tb_, prefixo;
    switch (jQuery('input[name="tipof"]:checked').val()) {
        case "sac":
            try {
                vf = jQuery("#vf_f").val().replaceAll(".", "").replace(",", ".");
                vf = parseFloat(vf);
                i = jQuery("#tj_f").val().replaceAll(".", "").replace(",", ".");
                n = tempotrans(jQuery("#t_f").val().replace(",", "."), jQuery("#tj_tf").val(), jQuery("#t_tf").val());
                vp = sacvp(vf, i, n, 1);
                vp = vp.toFixed(2);
                amt = saca(vp, n);
                dados = [];
                dadost = [];
                total = 0;
                dados.push(["Período", "Total", "Saldo Devedor"]);
                dadost.push(["Período", "Saldo Devedor", "Amortização", "Juros", "Prestação"]);
                vp_ = vp;
                ttamt = 0;
                for (var c = 1; c <= parseInt(n); c++) {
                    vp_ -= amt;
                    p = sacp(vp, i, n, c);
                    j = sacj(vp, i, n, c);
                    total += p;
                    linha = [c, total, vp_];
                    linhat = [c, vp_, amt, j, p];
                    dados.push(linha);
                    dadost.push(linhat);
                    ttamt += amt;
                }
                var options = {
                    legend: {
                        position: "bottom"
                    },
                    focusTarget: "category"
                };
                tb_ = '<table class="cv-table cv-table--card table"><tr><td>Valor financiado: </td><td>R$ ' + number_format(ttamt, 2, ',', '.') + "</td></tr>";
                tb_ += "<tr><td>Valor da 1ª prestação: </td><td>R$ " + number_format(vf, 2, ',', '.') + "</td></tr>";
                tb_ += "<tr><td>Taxa de juros: </td><td>" + number_format(i, 2, ',', '.') + " " + jQuery("#tj_tf :selected").text() + "</td></tr>";
                tb_ += "<tr><td>Tempo de financiamento: </td><td>" + jQuery("#t_f").val() + " " + jQuery("#t_tf :selected").text() + "</td></tr></table>";
            } catch (e) {}
            break;
        case "price":
            try {
                vf = jQuery("#vf_f").val().replaceAll(".", "").replace(",", ".");
                vf = parseFloat(vf);
                i = jQuery("#tj_f").val().replaceAll(".", "").replace(",", ".");
                n = tempotrans(jQuery("#t_f").val().replace(",", "."), jQuery("#tj_tf").val(), jQuery("#t_tf").val());
                vp = pricevp(vf, i, n);
                vp = vp.toFixed(2);
                p = pricep(vp, i, n);
                amt = 0;
                dados = [];
                dadost = [];
                total = 0;
                dados.push(["Período", "Total", "Saldo Devedor"]);
                dadost.push(["Período", "Saldo Devedor", "Amortização", "Juros", "Prestação"]);
                vp_ = vp;
                ttamt = 0;
                for (var c = 1; c <= parseInt(n); c++) {
                    amt = pricea(vp, p, i, c);
                    vp_ -= amt;
                    j = pricej(p, i, n, c);
                    total += p;
                    linha = [c, total, vp_];
                    linhat = [c, vp_, amt, j, p];
                    dados.push(linha);
                    dadost.push(linhat);
                    ttamt += amt;
                }
                var options = {
                    curveType: "function",
                    legend: {
                        position: "bottom"
                    },
                    focusTarget: "category"
                };
                tb_ = '<table class="cv-table cv-table--card table"><tr><td>Valor financiado: </td><td>R$ ' + number_format(ttamt, 2, ',', '.') + "</td></tr>";
                tb_ += "<tr><td>Valor da 1ª prestação: </td><td>R$ " + number_format(vf, 2, ',', '.') + "</td></tr>";
                tb_ += "<tr><td>Taxa de juros: </td><td>" + number_format(i, 2, ',', '.') + " " + jQuery("#tj_tf :selected").text() + "</td></tr>";
                tb_ += "<tr><td>Tempo de financiamento: </td><td>" + jQuery("#t_f").val() + " " + jQuery("#t_tf :selected").text() + "</td></tr></table>";
            } catch (e) {}
            break;
    }
    prefixo = jQuery("#tj_tf option:selected").text().replace("% ao", "");
    var data = google.visualization.arrayToDataTable(dados);
    var formatter0 = new google.visualization.NumberFormat({
        prefix: prefixo + ": ",
        fractionDigits: 2
    });
    var formatter = new google.visualization.NumberFormat({
        prefix: "R$ ",
        fractionDigits: 2
    });
    formatter.format(data, 1);
    formatter0.format(data, 0);
    try {
        formatter.format(data, 2);
    } catch (e) {}
    var chart = new google.visualization.LineChart(document.getElementById("graficof"));
    chart.draw(data, options);
    montatabf(dadost);
    jQuery("#tabresuf").html(tb_);
}

function drawChart_tj() {
    var vp, vf, n, i, amt, tb_, dados, dadost, total, vp_, p, j, linha, linhat, prefixo;
    switch (jQuery('input[name="tipof"]:checked').val()) {
