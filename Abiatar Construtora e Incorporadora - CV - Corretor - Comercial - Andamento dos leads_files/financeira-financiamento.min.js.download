                tb_ += "<tr><td>Tempo de financiamento: </td><td>" + jQuery("#t_f").val() + " " + jQuery("#t_tf :selected").text() + "</td></tr></table>";
                dados = [];
                dadost = [];
                total = 0;
                dados.push(["Período", "Total", "Saldo Devedor"]);
                dadost.push(["Período", "Saldo Devedor", "Amortização", "Juros", "Prestação"]);
                vp_ = vp;
                for (var c = 1; c <= parseInt(n); c++) {
                    vp_ -= amt;
                    p = sacp(vp, i, n, c);
                    j = sacj(vp, i, n, c);
                    total += p;
                    linha = [c, total, vp_];
                    linhat = [c, vp_, amt, j, p];
                    dados.push(linha);
                    dadost.push(linhat);
                }
                var options = {
                    legend: {
                        position: "bottom"
                    },
                    focusTarget: "category"
                };
            } catch (e) {}
            break;
        case "price":
            try {
                jQuery("#msgerrf").html("<p>No caso de SAF, Price e SAM, encontrar a taxa de juros não é possível. Tente na aba Calculadora.</p>");
                return;
            } catch (e) {}
            break;
    }
    prefixo = jQuery("#tj_tf option:selected").text().replace("% ao", "");
    var data = google.visualization.arrayToDataTable(dados);
    var formatter0 = new google.visualization.NumberFormat({
        prefix: prefixo + ": ",
        fractionDigits: 2
    });
    var formatter = new google.visualization.NumberFormat({
        prefix: "R$ ",
        fractionDigits: 2
    });
    formatter.format(data, 1);
    formatter0.format(data, 0);
    try {
        formatter.format(data, 2);
    } catch (e) {}
    var chart = new google.visualization.LineChart(document.getElementById("graficof"));
    chart.draw(data, options);
    montatabf(dadost);
    jQuery("#tabresuf").html(tb_);
}

