function montatabf(dados) {
    var lbl, lbl2, deno, tb, totj, totp, tota, v1, v2, v3, v4, v5, totj, totp, tota;
    lbl = jQuery("#tj_tf :selected").text();
    lbl = lbl.replace("% ao ", "");
    lbl2 = jQuery("#tt_tf :selected").text();
    lbl2 = lbl2.replace("% ao ", "");
    lbl2 = lbl2.replace("(s)", "");
    lbl2 = lbl2.replace("(es)", "");
    if (lbl != lbl2 && (lbl == "Semestre" || lbl == "Ano")) {
        deno = (lbl == "Ano") ? 12 : 6;
        tb = '<div class="row-fluid" style="margin-top:0px; max-height: 400px; overflow: auto"><table class="cv-table cv-table--card table">';
        tb += "<tr><th>Período</th><th>Saldo Devedor</th><th>Amortização</th><th>Juros</th><th>Prestação/" + lbl + "</th><th>Prestação/Mês</th></tr>";
        totj = 0;
        totp = 0;
        tota = 0;
        for (var i = 1; i <= dados.length; i++) {
            try {
                v1 = parseFloat(dados[i][1]);
                v1 = v1.toFixed(2);
                v1 = (v1 + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
                v2 = parseFloat(dados[i][2]);
                v2 = v2.toFixed(2);
                v2 = (v2 + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
                v3 = parseFloat(dados[i][3]);
                v3 = v3.toFixed(2);
                v3 = (v3 + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
                v4 = parseFloat(dados[i][4]);
                v4 = v4.toFixed(2);
                v4 = (v4 + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
                v5 = parseFloat(dados[i][4]) / deno;
                v5 = v5.toFixed(2);
                v5 = (v5 + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
                tb += "<tr><td>" + dados[i][0] + "</td><td>" + v1 + "</td><td>" + v2 + "</td><td>" + v3 + "</td><td>" + v4 + "</td><td>" + (v5) + "</td></tr>";
                totj += dados[i][3];
                totp += dados[i][4];
                tota += dados[i][2];
            } catch (e) {}
        }
        tota = tota.toFixed(2);
        tota = (tota + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
        totj = totj.toFixed(2);
        totj = (totj + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
        totp = totp.toFixed(2);
        totp = (totp + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
        tb += "<tr><td></td><td></td><td><strong>" + tota + "</strong></td><td><strong>" + totj + "</strong></td><td><strong>" + totp + "</strong></td><td></td></tr>";
        tb += "</table></div>";
        jQuery("#listaf").html(tb);
    } else {
        tb = '<div class="row-fluid" style="margin-top:0px; max-height: 400px; overflow: auto"><table class="cv-table cv-table--card table">';
        tb += "<tr><th>Período</th><th>Saldo Devedor</th><th>Amortização</th><th>Juros</th><th>Prestação</th></tr>";
        totj = 0;
        totp = 0;
        tota = 0;
        for (var i = 1; i <= dados.length; i++) {
            try {
                v1 = parseFloat(dados[i][1]);
                v1 = v1.toFixed(2);
                v1 = (v1 + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
                v2 = parseFloat(dados[i][2]);
                v2 = v2.toFixed(2);
                v2 = (v2 + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
                v3 = parseFloat(dados[i][3]);
                v3 = v3.toFixed(2);
                v3 = (v3 + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
                v4 = parseFloat(dados[i][4]);
                v4 = v4.toFixed(2);
                v4 = (v4 + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
                tb += "<tr><td>" + dados[i][0] + "</td><td>" + v1 + "</td><td>" + v2 + "</td><td>" + v3 + "</td><td>" + v4 + "</td></tr>";
                totj += dados[i][3];
                totp += dados[i][4];
                tota += dados[i][2];
            } catch (e) {}
        }
        tota = tota.toFixed(2);
        tota = (tota + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
        totj = totj.toFixed(2);
        totj = (totj + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
        totp = totp.toFixed(2);
        totp = (totp + "").replace(".", ",").replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1.");
        tb += "<tr><td></td><td></td><td><strong>" + tota + "</strong></td><td><strong>" + totj + "</strong></td><td><strong>" + totp + "</strong></td></tr>";
        tb += "</table></div>";
        jQuery("#listaf").html(tb);
    }
}

function mudaopcaof(obj) {
    jQuery("#vp_f").closest('.row-fluid').show();
    jQuery("#tj_f").closest('.row-fluid').show();
    jQuery("#t_f").closest('.row-fluid').show();
    jQuery("#vf_f").closest('.row-fluid').show();
    if (obj.value == "vpf") {
        jQuery("#vp_f").closest('.row-fluid').hide();
        jQuery("#t_tppf").attr("disabled", true);
    } else if (obj.value == "vff") {
        jQuery("#vf_f").closest('.row-fluid').hide();
    } else if (obj.value == "vpf") {
        jQuery("#t_tppf").closest('.row-fluid').hide();
    } else if (obj.value == "tjf") {
        jQuery("#t_tppf").val("ano");
        jQuery("#tj_f").closest('.row-fluid').hide();
    } else if (obj.value == "tf") {
        jQuery("#t_f").closest('.row-fluid').hide();
        jQuery("#t_tppf").val("ano");
    } 
}

function calcularf() {
    jQuery("#msgerrf").html("");
    switch (jQuery("#optcalcf").val()) {
        case "vpf":
            drawChart_vp();
            break;
        case "vff":
            drawChartf();
            break;
        case "tjf":
            drawChart_tj();
            break;
        case "tf":
            drawChart_t();
            break;
    }
}