                vp = jQuery("#vp_f").val().replaceAll(".", "").replace(",", ".");
                vp = parseFloat(vp);
                vf = jQuery("#vf_f").val().replaceAll(".", "").replace(",", ".");
                vf = parseFloat(vf);
                n = tempotrans(jQuery("#t_f").val().replace(",", "."), jQuery("#t_tppf").val(), jQuery("#t_tf").val());
                i = saci(vp, n, 1, vf);
                amt = saca(vp, n);
                tb_ = '<table class="cv-table cv-table--card table"><tr><td>Valor financiado: </td><td>R$ ' + number_format(vp, 2, ',', '.') + "</td></tr>";
