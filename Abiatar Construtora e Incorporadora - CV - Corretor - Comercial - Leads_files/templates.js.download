function c_rand() {
    var v0 = jQuery("#cx77_0").val();
    var v1 = jQuery("#cx77_1").val();
    calc("rand(" + v0 + ";" + v1 + ")", "Número aleatório entre " + v0 + " e " + v1 + "");
    jQuery("#cx77_0").val("");
