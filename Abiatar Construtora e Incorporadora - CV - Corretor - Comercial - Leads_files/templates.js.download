function rp_pi(a) {
    a = a.replace(/([a-z]+)pi+/gi, "$1*" + Math.PI);
    a = a.replace(/([0-9]+)pi+/gi, "$1*" + Math.PI);
    a = a.replace(/pi([a-z]+)/gi, Math.PI + "*$1");
    a = a.replace(/pi([0-9]+)/gi, Math.PI + "*$1");
    return a.replace(/pi/gi, Math.PI);
}

