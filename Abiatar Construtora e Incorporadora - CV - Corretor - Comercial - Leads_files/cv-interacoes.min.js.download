document.addEventListener("DOMContentLoaded",function(){var c=document.querySelectorAll(".cv-leads-acoes .cv-leads-acoes--button"),s=document.querySelectorAll(".cv-leads-acoes .cv-leads-acoes--tab");c.forEach(function(t){t.addEventListener("click",function(){var e=document.querySelector(t.getAttribute("data-bs-target"));e.classList.contains("show")?(e.classList.remove("show","active"),t.classList.remove("active")):(s.forEach(function(e){e.classList.remove("show","active")}),c.forEach(function(e){e.classList.remove("active")}),e.classList.add("show","active"),t.classList.add("active"))})})});