                    <div class="cv-load--icone" id="modalGPT-loading"><span class="cv-loader"></div>
                    <div class="box-msg new-message" id="modalGPT-new">nova mensagem</div>
                  </div>
                  <div class="modalgpt-actions" id="modalGPT-actions">
                      <!--<button  class="cv-btn-block -cinza -small" id="modalGPT-bt-old">Cancelar</button>-->
                      <div class="actions-left">
                          <div class="button-group modalGPT-btgroup-voice">
                            <div class="cv-btn-block -small " id="modalGPT-voice1" title="Texto tradicional"><i class="fa-regular fa-face-smile"></i></div>
                            <div class="cv-btn-block -small " id="modalGPT-voice2" title="Texto formal"><i class="fa-regular fa-face-glasses"></i></div>
                            <div class="cv-btn-block -small " id="modalGPT-voice3" title="Texto divertido"><i class="fa-regular fa-face-party"></i></div>
                          </div>
                          <div class="button-group modalGPT-btgroup-size">
                            <div class="cv-btn-block topIcon -small" id="modalGPT-bt4" title="Texto livre"><i class="fa-solid fa-bars"></i></div>
                            <div class="cv-btn-block topIcon -small " id="modalGPT-bt5" title="Texto médio"><i class="fa-regular fa-grip-lines"></i></div>
                            <div class="cv-btn-block topIcon -small " id="modalGPT-bt6" title="Texto curto"><i class="fa-regular fa-minus"></i></div>
                          </div>
                      </div>
                      <button  class="cv-btn-block  -magic -small" id="modalGPT-bt-new">Usar</button>
                  </div>

              </div>
