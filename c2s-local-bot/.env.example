# ---------------------------------------------------------------------------
# C2S Local Bot — variaveis de ambiente (build time)
# Copie para .env e preencha. NUNCA versione o .env.
# ---------------------------------------------------------------------------

# Chave PUBLICA Ed25519 usada para validar licencas offline (.lic).
#
# Use a forma RAW BASE64 (uma linha, 44 caracteres) impressa por:
#   node scripts/license.mjs keygen
# A forma PEM tambem funciona, mas so se ficar em UMA linha: `.env` nao aceita
# quebra de linha e o build falha de proposito se a chave vier truncada.
VITE_LICENSE_PUBLIC_KEY=""

# Liga a automacao no bundle. Padrao: desligada.
# "true" = o actionGuard pode aprovar acoes (ainda dependendo de opt-in,
# calibracao, licenca valida e a acao ligada nas Configuracoes).
VITE_AUTOMATION_ENABLED="false"

# API opcional de licenca (F7). Deixe vazio na v1 (licenca offline).
VITE_LICENSE_API_BASE=""

# Telemetria agregada opcional. Vazio = desativada (padrao).
VITE_TELEMETRY_ENDPOINT=""

# Ambiente: development | production
VITE_APP_ENV="production"
