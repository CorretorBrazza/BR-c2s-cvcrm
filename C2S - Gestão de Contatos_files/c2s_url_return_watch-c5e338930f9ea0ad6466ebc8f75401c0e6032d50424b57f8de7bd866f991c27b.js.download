function checkC2sUrlReferrer(){""==getCookie("c2sUrlReferrer")&&setCookie("c2sUrlReferrer",document.URL,10),getCookie("c2sUrlReferrer")!=document.URL&&"leads"!=urlWords[4]&&setCookie("c2sUrlReferrer",document.URL,10),urlWords.length>5&&("v2"==urlWords[5].split("#")[0]||"v2"==urlWords[5].split("?")[0])&&"leads"==urlWords[4]&&setCookie("c2sUrlReferrer",document.URL,10)}function returnUrlLead(){var e=$("#has_page").val();if(e){var r=/page=\d/;window.location.href=getCookie("c2sUrlReferrer").replace(r,"page="+e)}else location.href=getCookie("c2sUrlReferrer")}function setCookie(e,r,o){var t=new Date;t.setTime(t.getTime()+24*o*60*60*1e3);var c="expires="+t.toUTCString();document.cookie=e+"="+r+";"+c+";path=/"}function getCookie(e){for(var r=e+"=",o=document.cookie.split(";"),t=0;t<o.length;t++){for(var c=o[t];" "==c.charAt(0);)c=c.substring(1);if(0==c.indexOf(r))return c.substring(r.length,c.length)}return""}$(document).click(function(){checkC2sUrlReferrer()}),$(document).ready(function(){checkC2sUrlReferrer()});var urlWords=document.URL.split("/");